# Bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/

# Large expression matrices, checkpoints, and scratch outputs
data/raw/
*.h5ad
*.pth
*.pt
*.ckpt
*.zip
*.tar.gz
graph_preprocess/
experiments/runs/*/batches.json
experiments/runs/*/spot_embedding.npy
experiments/runs/*/gene_embedding.npy
experiments/runs/*/minibatch_spot_embedding.npy
experiments/runs/*/selection.npy
experiments/runs/*/spatial_edges.npy
experiments/runs/*/*_embedding.npy
experiments/runs/*/warmup_embedding_ep*.npy

# Never commit manuscript drafts, TeX sources, or PDFs
manuscript/
report/
reports_pdf/
*.pdf
*.tex
*.aux
*.bbl
*.blg
*.log
*.out

# Environment and local tooling
.env
.venv/
venv/
envs/
tmp/
.DS_Store
Thumbs.db
